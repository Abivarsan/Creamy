<UserControl x:Class="Creamy.WPF.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Creamy.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CustomerViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource MainBgBrush}">

    <Grid Margin="24">
        <!-- Main Customer Content Area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customer Records" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Manage customer contact profiles, preferences, and addresses." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Search & Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Width="240"
                             Margin="0,0,10,0"
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Style="{StaticResource OutlineButton}"
                            Command="{Binding SearchCommand}"
                            Content="🔍 Search"
                            Margin="0,0,14,0"
                            Padding="12,8" />

                    <!-- Add Customer Button (Allowed for All Roles) -->
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenCreateDialogCommand}"
                            Content="+ Add Customer" />
                </StackPanel>
            </Grid>

            <!-- Message / Error Notification Banner -->
            <Border Grid.Row="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#ecfdf5" />
                        <Setter Property="BorderBrush" Value="#a7f3d0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                <Setter Property="Background" Value="#fef2f2" />
                                <Setter Property="BorderBrush" Value="#fecaca" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Message}" FontWeight="Medium" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Customers DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="1.8*" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.2*" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*" />
                        <DataGridTextColumn Header="Notes / Preferences" Binding="{Binding Notes}" Width="2*" />

                        <!-- Row Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Edit button: Allowed for All Roles -->
                                        <Button Style="{StaticResource OutlineButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Content="Edit"
                                                Margin="0,0,6,0"
                                                Padding="10,4" />

                                        <!-- Delete button: Allowed for Owner Only -->
                                        <Button Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Content="Delete"
                                                IsEnabled="{Binding DataContext.CanDeleteCustomer, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="Delete customer (Owner role only)" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Add / Edit Customer Modal Dialog Overlay -->
        <Grid Background="#80000000"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="10"
                    Width="480"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.25" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="{StaticResource TextPrimaryBrush}" />

                    <!-- Name -->
                    <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Phone -->
                    <TextBlock Text="Phone Number" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Email -->
                    <TextBlock Text="Email Address (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Address -->
                    <TextBlock Text="Address (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Notes -->
                    <TextBlock Text="Notes / Preferences (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,20" />

                    <!-- Dialog Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineButton}"
                                Command="{Binding CloseFormCommand}"
                                Content="Cancel"
                                Margin="0,0,10,0"
                                Padding="16,8" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveFormCommand}"
                                Content="Save Customer"
                                Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
