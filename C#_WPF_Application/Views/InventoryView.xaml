<UserControl x:Class="Creamy.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Creamy.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:InventoryViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050"
             Background="{StaticResource MainBgBrush}">

    <Grid Margin="28,24,28,24">
        <!-- Main Inventory Container -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: KPI Summary Metric Cards -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Search & Actions Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Status Toast Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Items DataGrid Card -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== 1. KPI SUMMARY METRIC CARDS ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Flavors -->
                <Border Grid.Column="0" Margin="0,0,12,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.04" Color="#0f172a" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL FLAVORS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalFlavorsCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="#e0e7ff" VerticalAlignment="Center">
                            <TextBlock Text="🍨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI Card 2: Total Stock in Hand -->
                <Border Grid.Column="1" Margin="6,0,6,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.04" Color="#0f172a" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL STOCK (UNITS)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalStockQuantity}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="#ecfdf5" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI Card 3: Low Stock Warning -->
                <Border Grid.Column="2" Margin="6,0,6,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.04" Color="#0f172a" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LOW STOCK ALERTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Foreground="#f59e0b" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="#fffbeb" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI Card 4: Categories Count -->
                <Border Grid.Column="3" Margin="12,0,0,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.04" Color="#0f172a" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ActiveCategoriesCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="#fdf2f8" VerticalAlignment="Center">
                            <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 2. SEARCH & ACTIONS BAR ==================== -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.03" Color="#0f172a" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title summary -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Inventory Catalog" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Search, filter, and adjust store inventory levels" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Right Controls: Search, Filter, Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Search Box -->
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Width="230"
                                 Margin="0,0,10,0"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Search Button -->
                        <Button Style="{StaticResource OutlineButton}"
                                Command="{Binding SearchCommand}"
                                Content="🔍 Search"
                                Margin="0,0,10,0"
                                Height="38" />

                        <!-- Category Dropdown Filter -->
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Width="135"
                                  Height="38"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0" />

                        <!-- Refresh Button -->
                        <Button Style="{StaticResource OutlineButton}"
                                Command="{Binding RefreshCommand}"
                                Content="🔄"
                                ToolTip="Reload Inventory from API"
                                Margin="0,0,12,0"
                                Height="38" />

                        <!-- Add Item Primary Button (RBAC: Owner & Manager only) -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCreateDialogCommand}"
                                Content="+ Add Flavor"
                                Height="38"
                                IsEnabled="{Binding CanCreateItem}"
                                ToolTip="Add New Ice Cream Item (Owner &amp; Manager only)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 3. NOTIFICATION BANNER ==================== -->
            <Border Grid.Row="2"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Message}" FontWeight="SemiBold" FontSize="12.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- ==================== 4. ITEMS DATAGRID CARD ==================== -->
            <Border Grid.Row="3" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.04" Color="#0f172a" />
                </Border.Effect>

                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <!-- ID -->
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />

                        <!-- Name -->
                        <DataGridTemplateColumn Header="FLAVOR NAME" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Category Pill -->
                        <DataGridTemplateColumn Header="CATEGORY" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CategoryBadgeBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FlavorCategory}" Foreground="{Binding CategoryBadgeFg}" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Price -->
                        <DataGridTemplateColumn Header="UNIT PRICE (RS.)" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PriceFormatted}" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center" FontSize="13" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock Status Badge -->
                        <DataGridTemplateColumn Header="STOCK AVAILABILITY" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StockBadgeBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StockBadgeDot}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StockBadgeFg}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions (Edit & Delete) -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Edit button (All roles) -->
                                        <Button Style="{StaticResource OutlineButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Content="✏️ Edit"
                                                Margin="0,0,6,0"
                                                Padding="10,4" />

                                        <!-- Delete button (Owner only) -->
                                        <Button Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Content="🗑️ Delete"
                                                IsEnabled="{Binding DataContext.CanDeleteItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="Delete item (Owner role only)" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ==================== 5. ADD / EDIT ITEM MODAL OVERLAY ==================== -->
        <Grid Background="#700f172a"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="16"
                    Width="520"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.25" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Enter details below to update the inventory catalog." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Close button -->
                        <Button Grid.Column="1" Command="{Binding CloseFormCommand}" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="12" />
                    </Grid>

                    <!-- Flavor Name -->
                    <TextBlock Text="Flavor / Item Name" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <!-- Category & Unit -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Category -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Flavor Category" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding FormCategory}"
                                      Height="38" />
                        </StackPanel>

                        <!-- Unit -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Unit of Measure" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Price & Stock Quantity -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Price -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Selling Price (Rs. / LKR)" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Quantity -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Available Stock Count" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Description &amp; Tasting Notes" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Height="65"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,24" />

                    <!-- Dialog Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineButton}"
                                Command="{Binding CloseFormCommand}"
                                Content="Cancel"
                                Margin="0,0,10,0"
                                Padding="18,8" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveFormCommand}"
                                Content="Save Flavor Record"
                                Padding="22,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
