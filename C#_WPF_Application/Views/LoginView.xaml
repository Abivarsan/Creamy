<UserControl x:Class="Creamy.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Creamy.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050"
             Background="{StaticResource MainBgBrush}">

    <Grid>
        <!-- Soft Ambient Background Decorative Orbs -->
        <Canvas IsHitTestVisible="False">
            <!-- Top Right Soft Indigo Orb -->
            <Ellipse Canvas.Right="-100" Canvas.Top="-100" Width="400" Height="400" Fill="#106366f1" />
            <!-- Bottom Left Soft Pink Orb -->
            <Ellipse Canvas.Left="-80" Canvas.Bottom="-80" Width="350" Height="350" Fill="#10ec4899" />
        </Canvas>

        <!-- Center Floating Login Card -->
        <Border Background="White"
                CornerRadius="18"
                Width="500"
                Padding="40,36"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.08" Color="#0f172a" />
            </Border.Effect>

            <StackPanel>
                <!-- Brand Badge & Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource PrimaryGradient}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.30" Color="#6366f1" />
                        </Border.Effect>
                        <TextBlock Text="🍦" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Creamy Ice Cream" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to your staff management portal" 
                               FontSize="13.5" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Error Alert Box -->
                <Border Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,18"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{StaticResource DangerBrush}" 
                                   TextWrapping="Wrap" 
                                   FontSize="12.5" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Email Input -->
                <TextBlock Text="Email Address" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <!-- Password Input -->
                <TextBlock Text="Password" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,22" />

                <!-- Submit Sign In Button -->
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        Content="Sign In to Terminal →"
                        Height="46"
                        FontSize="14"
                        Margin="0,0,0,24" />

                <!-- Quick-Select Role Presets (Interactive Cards) -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="⚡ QUICK SELECT ROLE (ASSESSMENT DEMO)" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextMutedBrush}" 

                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,12" />

                        <!-- 3 Role Selector Cards -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Role 1: Owner -->
                            <Button Grid.Column="0"
                                    Command="{Binding SetOwnerCredentialsCommand}"
                                    Margin="0,0,6,0"
                                    Background="#fffbeb"
                                    BorderBrush="#fde68a"
                                    BorderThickness="1"
                                    Padding="10,12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="10" 
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="👑" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Owner" FontWeight="Bold" FontSize="12.5" Foreground="#b45309" HorizontalAlignment="Center" />
                                                <TextBlock Text="Full CRUD" FontSize="10.5" Foreground="#d97706" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Role 2: Manager -->
                            <Button Grid.Column="1"
                                    Command="{Binding SetManagerCredentialsCommand}"
                                    Margin="3,0,3,0"
                                    Background="#eff6ff"
                                    BorderBrush="#bfdbfe"
                                    BorderThickness="1"
                                    Padding="10,12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="10" 
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="👔" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Manager" FontWeight="Bold" FontSize="12.5" Foreground="#1d4ed8" HorizontalAlignment="Center" />
                                                <TextBlock Text="Ops &amp; Stock" FontSize="10.5" Foreground="#3b82f6" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Role 3: Cashier -->
                            <Button Grid.Column="2"
                                    Command="{Binding SetCashierCredentialsCommand}"
                                    Margin="6,0,0,0"
                                    Background="#ecfdf5"
                                    BorderBrush="#a7f3d0"
                                    BorderThickness="1"
                                    Padding="10,12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="10" 
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Cashier" FontWeight="Bold" FontSize="12.5" Foreground="#047857" HorizontalAlignment="Center" />
                                                <TextBlock Text="POS &amp; Clients" FontSize="10.5" Foreground="#10b981" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
