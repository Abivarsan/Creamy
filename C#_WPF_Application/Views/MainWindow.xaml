<Window x:Class="Creamy.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Creamy.WPF.ViewModels"
        xmlns:views="clr-namespace:Creamy.WPF.Views"
        mc:Ignorable="d"
        Title="Creamy - Ice Cream Shop Management (Delivergate Assessment)" 
        Height="780" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBgBrush}"
        d:DataContext="{d:DesignInstance viewmodels:MainViewModel}">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CustomerViewModel}">
            <views:CustomerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Width 250 when authenticated, Width 0 when not -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Modern Dark Slate Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                Width="240"
                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand / Header -->
                <Border Grid.Row="0" Padding="20,24" BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🍦" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Creamy" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Shop Management System" FontSize="11" Foreground="#94a3b8" />
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Margin="12,20,12,0">
                    <!-- Inventory Items Button -->
                    <Button Command="{Binding NavigateInventoryCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="14,12"
                            Margin="0,0,0,6"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0" />
                                        <TextBlock Text="Inventory Items" FontSize="14" FontWeight="SemiBold" Foreground="#f8fafc" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Customers Button -->
                    <Button Command="{Binding NavigateCustomersCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="14,12"
                            Margin="0,0,0,6"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👥" FontSize="16" Margin="0,0,12,0" />
                                        <TextBlock Text="Customer Records" FontSize="14" FontWeight="SemiBold" Foreground="#f8fafc" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- User Profile & Logout Section -->
                <Border Grid.Row="2" Background="#0f172a" Padding="16,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            <!-- Role Badge -->
                            <Border Background="{Binding RoleBadgeColor}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding RoleBadge}" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentUser.Email}" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,14" />

                        <!-- Logout Button -->
                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource OutlineButton}"
                                Content="🚪 Sign Out"
                                HorizontalAlignment="Stretch"
                                Foreground="#f87171"
                                BorderBrush="#475569" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main View Host Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
